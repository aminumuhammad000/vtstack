# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Auth Secret
JWT_SECRET=vtstack-production-jwt-secret-replace-with-secure-key
JWT_EXPIRES_IN=7d

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# Gateway Integration Keys (PalmPay / Zainpay / Payrant)
PALMPAY_APP_ID=your-palmpay-app-id
PALMPAY_SECRET_KEY=your-palmpay-secret-key
PALMPAY_BASE_URL=https://open-api.palmpay-inc.com

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=VTStack <support@vtstack.ng>
SUPPORT_EMAIL=support@vtstack.ng
NEXT_PUBLIC_SUPPORT_EMAIL=support@vtstack.ng
